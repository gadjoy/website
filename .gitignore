# Hugo build output (rebuilt by GitHub Actions on deploy — not committed)
/public/
/resources/_gen/
.hugo_build.lock

# Python migration tooling
migration/.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets — never commit
.env
.env.*

# Machine-local Claude Code settings
.claude/settings.local.json

# OS cruft
.DS_Store
wordpress/docker-compose.override.yml

# Claude Code agent worktrees — nested git repos, never part of this repo.
.claude/worktrees/

# WordPress stock themes from the export: never used by the Hugo site, and their
# npm lockfiles generated every Dependabot alert on this repo (70, incl. 14 critical).
migration/wp-export/wp-content/themes/

# Coverage artifacts. The floor lives in the Makefile; the data files are per-run.
.coverage
.coverage.*
htmlcov/
coverage.xml
e2e/_output/
# personal values the house-gates hook refuses to commit; never tracked
.house-gates.denylist
